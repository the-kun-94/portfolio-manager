# Copy this file to .env.local for local dev, or set the same key in your
# Vercel project's Environment Variables for the deployed build.
#
# Local dev (backend running via `uvicorn` on your machine):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Once the backend is deployed (e.g. to Render), set this to that URL instead:
# NEXT_PUBLIC_API_BASE_URL=https://emotionless-executioner-api.onrender.com
#
# Must match the backend's API_KEY exactly (see backend/.env.example).
# NEXT_PUBLIC_API_KEY=
#
# Login gate (frontend-only, server-side — never sent to the browser).
# Leave both unset for local dev to skip the login page entirely.
# SITE_PASSWORD=
# SESSION_SECRET=
