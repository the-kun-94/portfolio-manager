# Copy to .env for local dev (python-dotenv loads it automatically), or set
# these as Environment Variables in your Render service dashboard for prod.

# Local dev default (SQLite, zero config) — leave unset to use it.
# DATABASE_URL=sqlite:///./the_kun_algorithm.db

# Production (Neon Postgres — see DEPLOYMENT.md):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Comma-separated list of frontend origins allowed to call this API.
# Add your Vercel URL once the frontend is deployed.
CORS_ORIGINS=http://localhost:3000

# Shared secret required on every endpoint except /api/health once deployed
# publicly (see app/auth.py). Leave unset for local dev. Must match the
# frontend's (private, non-NEXT_PUBLIC) API_KEY exactly.
# API_KEY=

# Optional second key that authenticates but is only ever granted read
# access — POST /api/trades, /api/cash/deposit, /api/cash/withdraw,
# /api/reinvestment/park, and /api/reinvestment/unpark all reject it with
# 403. Leave unset to not offer read-only access. Must match the
# frontend's (private) API_KEY_READONLY exactly.
# API_KEY_READONLY=
